@model IEnumerable<DetectiveCaseFileSystem.Models.Case>

@{
    ViewData["Title"] = "All Cases";
}

<section class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Active Investigations</h2>
        <a asp-action="Create" class="btn btn-outline-primary">Open New Case</a>
    </div>

    <div class="row">
        @foreach (Case caseItem in Model)
        {
            <article class="col-md-4 mb-4 d-flex">
                <div class="card w-100 border-0 shadow border-start border-5 border-warning">
                    <!-- Card header -->
                    <div class="card-header bg-dark text-warning font-monospace fw-bold d-flex justify-content-between align-items-center">
                        <span class="text-uppercase">#@caseItem.CaseNumber</span>
                        <span>Opened: @caseItem.TimeOfCrime?.ToString("MMM dd, yyyy")</span>
                    </div>

                    <!-- Card main content -->
                    <div class="card-body">
                        <h3 class="card-title h5 fw-bold mb-3">@caseItem.Title</h3>
                        <p class="card-text text-secondary text-truncate" style="height: 3rem; overflow: hidden;">@caseItem.Description</p>

                        <div class="d-flex gap-2 mt-3">
                            <span class="badge bg-dark text-warning">Priority: @caseItem.PriorityLevel</span>
                            <span class="badge bg-light text-dark border">Status: @caseItem.Status</span>
                        </div>
                    </div>

                    <!-- Card footer -->
                    <div class="card-footer bg-white border-top-0 pb-3 d-flex gap-2 d-flex justify-content-between align-items-center">
                        <a href="/Cases/Details/@caseItem.Id" class="btn btn-outline-dark">Access File &rarr;</a>
                        <form asp-action="Delete" asp-route-id="@caseItem.Id" method="post" onsubmit="return confirm('Permanently remove this case file?');">
                            <button type="submit" class="btn btn-danger" title="Delete Case File">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
</section>