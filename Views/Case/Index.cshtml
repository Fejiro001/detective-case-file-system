@model IEnumerable<DetectiveCaseFileSystem.Models.Case>

@{
    ViewData["Title"] = "All Cases";
}

<section>
    <h2 class="mb-4">Investigations</h2>

    <div class="row">
        @foreach (Case caseItem in Model)
        {
            <article class="col-md-4 mb-4 d-flex">
                <div class="card w-100 border-warning shadow-sm">
                    <!-- Card header -->
                    <div class="card-header bg-dark text-warning fw-bold d-flex justify-content-between align-items-center">
                        <span>@caseItem.CaseNumber</span>
                        @if (caseItem.TimeOfCrime.HasValue)
                        {
                            <time datetime="@caseItem.TimeOfCrime.Value.ToString("yyyy-MM-ddTHH:mm")">@caseItem.TimeOfCrime.Value.ToString("MMM dd")</time>
                        }
                    </div>

                    <!-- Card main content -->
                    <div class="card-body">
                        <h3 class="card-title h5">@caseItem.Title</h3>
                        <p class="card-text text-muted small text-truncate">@caseItem.Description</p>

                        <div class="mt-3">
                            <span class="badge bg-danger" title="Priority Level">@caseItem.PriorityLevel</span>
                            <span class="badge bg-danger" title="Status">@caseItem.Status</span>
                        </div>
                    </div>

                    <!-- Card footer -->
                    <div class="card-footer bg-transparent border-top-0">
                        <a href="/Cases/Details/@caseItem.Id" class="btn btn-outline-dark btn-sm w-100">Open File &rarr;</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>