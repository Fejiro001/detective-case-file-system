@model IEnumerable<DetectiveCaseFileSystem.Models.Case>

@{
    ViewData["Title"] = "All Cases";
}

<section class="case-index-container">
    <header class="index-header">
        <div class="header-titles">
            <span class="classification-tag">CLASSIFIED // ARCHIVE</span>
            <h2 class="index-title">Active Investigations</h2>
        </div>
        <a asp-action="Create" class="btn-primary">Open New Case</a>
    </header>

    <div class="case-grid">
        @foreach (Case caseItem in Model)
        {
            <article class="case-card">
                <header class="card-top-bar">
                    <span class="case-id font-mono">#@caseItem.CaseNumber</span>
                    <span class="case-date font-mono">Opened: @(caseItem.TimeOfCrime?.ToString("MMM dd, yyyy") ?? "UNKNOWN")</span>
                </header>

                <div class="card-content">
                    <h3 class="card-title">@caseItem.Title</h3>
                    <p class="card-desc">@caseItem.Description</p>

                    <div class="badge-group">
                        <span class="badge priority-badge">Priority: @caseItem.PriorityLevel</span>
                        <span class="badge status-badge">Status: @caseItem.Status</span>
                    </div>
                </div>

                <footer class="card-actions">
                    <a asp-action="Details" asp-route-id="@caseItem.Id" class="btn-secondary">Access File &rarr;</a>
                    <form asp-action="Delete" asp-route-id="@caseItem.Id" method="post" class="delete-form" onsubmit="return confirm('Permanently remove this case file?');">
                        <button type="submit" class="btn-danger" title="Delete Case File">Delete</button>
                    </form>
                </footer>
            </article>
        }
    </div>
</section>