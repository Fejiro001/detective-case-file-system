@model DetectiveCaseFileSystem.Models.Case

@{
    ViewData["Title"] = "View Case Details";
}

<section class="case-details-container">
    <article class="case-card">
        <!-- Case Header -->
        <header class="case-header">
            <div class="case-title-block">
                <span class="classification-tag">CLASSIFIED // CASE FILE</span>
                <h2 class="case-title">@Model.Title</h2>
                <p class="case-file-number">FILE NO: @Model.CaseNumber</p>
            </div>
            <div class="case-status-block">
                <span class="badge status-badge">@Model.Status</span>
                <span class="badge priority-badge">@Model.PriorityLevel Priority</span>
            </div>
        </header>

        <!-- Main Body: Incident Report & Operational Meta -->
        <div class="case-body">
            <section class="case-main">
                <h3 class="section-heading">Incident Report</h3>
                <div class="report-content">
                    <p class="description-text">@Model.Description</p>
                </div>
            </section>

            <aside class="case-sidebar">
                <h3 class="sidebar-heading">Operational Meta</h3>
                <dl class="meta-list">
                    <div class="meta-item">
                        <dt class="meta-label">Assigned Investigator</dt>
                        <dd class="meta-value">@Model.Investigator</dd>
                    </div>

                    <div class="meta-item">
                        <dt class="meta-label">Crime Classification</dt>
                        <dd class="meta-value">@Model.CrimeType</dd>
                    </div>

                    <div class="meta-item">
                        <dt class="meta-label">Incident Location</dt>
                        <dd class="meta-value">@Model.Location</dd>
                    </div>

                    <div class="meta-item">
                        <dt class="meta-label">Timestamp</dt>
                        <dd class="meta-value font-mono">
                            @(Model.TimeOfCrime?.ToString("yyyy-MM-dd HH:mm") ?? "UNKNOWN")
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>

        <!-- Case Actions -->
        <footer class="case-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary">Edit Case</a>
            <a asp-action="Index" class="btn-secondary">Back to Archives</a>
        </footer>
    </article>
</section>