@model DetectiveCaseFileSystem.Models.Case

@{
    ViewData["Title"] = "Edit Case";
}

<section class="case-edit-container">
    <header class="case-edit-header">
        <h2 class="case-edit-title">Modify Case File</h2>
        <span class="case-file-badge">@Model.CaseNumber</span>
    </header>

    <form asp-action="Edit" method="post" class="case-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <!-- Hidden ID is strictly required for Edit forms -->
        <input type="hidden" asp-for="Id" />

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="CaseNumber" class="form-label font-mono"></label>
                <input asp-for="CaseNumber" class="form-control font-mono" />
                <span asp-validation-for="CaseNumber" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="validation-error"></span>
            </div>
        </div>

        <div class="form-group full-width">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>

        <fieldset class="case-meta-fieldset">
            <legend class="sr-only">Operational Meta</legend>
            <div class="form-grid-3">
                <div class="form-group">
                    <label asp-for="Location" class="meta-label"></label>
                    <input asp-for="Location" class="form-control-sm" />
                    <span asp-validation-for="Location" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TimeOfCrime" class="meta-label"></label>
                    <input asp-for="TimeOfCrime" type="datetime-local" class="form-control-sm" />
                    <span asp-validation-for="TimeOfCrime" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Investigator" class="meta-label"></label>
                    <input asp-for="Investigator" class="form-control-sm" />
                    <span asp-validation-for="Investigator" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CrimeType" class="meta-label"></label>
                    <select asp-for="CrimeType" class="form-select-sm" asp-items="Html.GetEnumSelectList<DetectiveCaseFileSystem.Models.CrimeType>()"></select>
                    <span asp-validation-for="CrimeType" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PriorityLevel" class="meta-label"></label>
                    <select asp-for="PriorityLevel" class="form-select-sm" asp-items="Html.GetEnumSelectList<DetectiveCaseFileSystem.Models.PriorityLevel>()"></select>
                    <span asp-validation-for="PriorityLevel" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="meta-label"></label>
                    <select asp-for="Status" class="form-select-sm" asp-items="Html.GetEnumSelectList<DetectiveCaseFileSystem.Models.Status>()"></select>
                    <span asp-validation-for="Status" class="validation-error"></span>
                </div>
            </div>
        </fieldset>

        <footer class="form-actions">
            <a asp-action="Index" class="btn-secondary">Abort</a>
            <button type="submit" class="btn-primary">Commit Updates</button>
        </footer>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}