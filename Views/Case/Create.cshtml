@model Case

@{
    ViewData["Title"] = "Add Case";
}

<section class="case-form-container">
    <header class="form-header">
        <span class="classification-tag">CLASSIFIED // DOSSIER CREATION</span>
        <h2 class="form-title">Open New Investigation</h2>
    </header>

    <form asp-action="Create" method="post" class="case-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <!-- Section 1: Identification -->
        <fieldset class="form-section">
            <legend class="section-title">Case Identification</legend>
            <div class="form-grid dual-column">
                <div class="form-group">
                    <label asp-for="CaseNumber" class="form-label"></label>
                    <input asp-for="CaseNumber" class="form-control font-mono" placeholder="e.g. CASE-2026-003" />
                    <span asp-validation-for="CaseNumber" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter incident title..." />
                    <span asp-validation-for="Title" class="validation-message"></span>
                </div>
            </div>

            <div class="form-group full-width">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Provide detailed incident summary..."></textarea>
                <span asp-validation-for="Description" class="validation-message"></span>
            </div>
        </fieldset>

        <!-- Section 2: Incident Parameters -->
        <fieldset class="form-section">
            <legend class="section-title">Incident Parameters</legend>
            <div class="form-grid dual-column">
                <div class="form-group">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="Crime scene location..." />
                    <span asp-validation-for="Location" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TimeOfCrime" class="form-label"></label>
                    <input asp-for="TimeOfCrime" type="datetime-local" class="form-control font-mono" />
                    <span asp-validation-for="TimeOfCrime" class="validation-message"></span>
                </div>
            </div>
        </fieldset>

        <!-- Section 3: System Classification & Assignment -->
        <fieldset class="form-section system-meta-group">
            <legend class="section-title">System Classification & Assignment</legend>
            <div class="form-grid dual-column">
                <div class="form-group">
                    <label asp-for="Investigator" class="form-label"></label>
                    <input asp-for="Investigator" class="form-control" placeholder="Lead investigator name..." />
                    <span asp-validation-for="Investigator" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CrimeType" class="form-label"></label>
                    <select asp-for="CrimeType" class="form-select" asp-items="Html.GetEnumSelectList<CrimeType>()">
                        <option value="">-- Select Crime Type --</option>
                    </select>
                    <span asp-validation-for="CrimeType" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PriorityLevel" class="form-label"></label>
                    <select asp-for="PriorityLevel" class="form-select" asp-items="Html.GetEnumSelectList<PriorityLevel>()">
                        <option value="">-- Select Priority --</option>
                    </select>
                    <span asp-validation-for="PriorityLevel" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Status>()">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Status" class="validation-message"></span>
                </div>
            </div>
        </fieldset>

        <!-- Form Actions -->
        <div class="form-actions">
            <a asp-action="Index" class="btn-secondary">&larr; Back to Archives</a>
            <button type="submit" class="btn-primary">Open Case</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}