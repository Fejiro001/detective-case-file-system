@model IEnumerable<DetectiveCaseFileSystem.Models.Evidence>

@{
    ViewData["Title"] = "All Evidence";
}

<section>
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h2>Evidence Locker</h2>
        <a href="/Evidence/Create" class="btn btn-dark">Log New Evidence</a>
    </div>

    <div class="row">
        @foreach (Evidence evidence in Model)
        {
            <article class="col-md-3 col-sm-6 mb-4 d-flex">
                <div class="card w-100 shadow-sm border-secondary">
                    <figure>
                        <img src="@(string.IsNullOrEmpty(evidence.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : evidence.ImageUrl)"
                             class="card-img-top border-bottom"
                             alt="Photograph of @evidence.Type"
                             style="height: 200px; object-fit: cover;"/>
                        <figcaption class="position-absolute top-0 end-0 bg-dark text-white p-1 m-2 rounded small">
                            Tag: #@evidence.Id
                        </figcaption>
                    </figure>

                    <div class="card-body flex-grow-1">
                        <div>
                            <h3 class="h5 text-uppercase fw-bold mb-1">@evidence.Type</h3>
                        </div>
                        <p class="card-text text-muted small text-truncate">
                            @evidence.Description
                        </p>
                        <dl class="mb-0 small mt-3 border-start border-warning border-3 ps-2">
                            <dt class="text-secondary fw-normal mb-0">Recovered:</dt>
                            <dd class="mb-1">@evidence.DateCollected.ToString("MM dd, yyyy")</dd>

                            <dt class="text-secondary fw-normal mb-0">Location:</dt>
                            <dd class="mb-0 text-truncate">@evidence.LocationFound</dd>
                        </dl>
                    </div>

                    <div class="card bg-light border-top-0">
                        <a href="/Evidence/Details/@evidence.Id" class="btn btn-outline-secondary btn-sm w-100">Forensic Details &rarr;</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>