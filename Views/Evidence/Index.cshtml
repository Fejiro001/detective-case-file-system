@model IEnumerable<Evidence>

@{
    ViewData["Title"] = "All Evidence";
}

<section class="evidence-index-container">
    <header class="index-header">
        <div class="header-titles">
            <span class="classification-tag info-tag">FORENSIC VAULT // EVIDENCE ARCHIVE</span>
            <h2 class="index-title">Evidence Locker</h2>
        </div>
        <a asp-action="Create" class="btn-primary btn-info">Log New Evidence</a>
    </header>

    <div class="evidence-grid">
        @foreach (Evidence evidence in Model)
        {
            <article class="evidence-card">
                <figure class="evidence-card-media">
                    <img src="@(evidence.ImageUrl)"
                         class="evidence-card-image"
                         alt="Photograph of @evidence.Type" />
                    <figcaption class="tag-badge font-mono">
                        Tag: #@evidence.Id
                    </figcaption>
                </figure>

                <div class="card-content">
                    <h3 class="card-title">@evidence.Type</h3>
                    <p class="card-desc">@evidence.Description</p>

                    <dl class="evidence-meta">
                        <div class="meta-row">
                            <dt class="meta-label">Recovered:</dt>
                            <dd class="meta-value font-mono">@evidence.DateCollected.ToString("MM dd, yyyy")</dd>
                        </div>
                        <div class="meta-row">
                            <dt class="meta-label">Location:</dt>
                            <dd class="meta-value">@evidence.LocationFound</dd>
                        </div>
                    </dl>
                </div>

                <footer class="card-actions">
                    <a asp-action="Details" asp-route-id="@evidence.Id" class="btn-secondary">Details &rarr;</a>
                    <form asp-action="Delete" asp-route-id="@evidence.Id" method="post" class="delete-form" onsubmit="return confirm('Destroy evidence record?');">
                        <button type="submit" class="btn-danger" title="Delete Evidence Record">Delete</button>
                    </form>
                </footer>
            </article>
        }
    </div>
</section>