@model IEnumerable<Suspect>

@{
    ViewData["Title"] = "All Suspects";
}

<section class="suspect-index-container">
    <header class="index-header">
        <div class="header-titles">
            <span class="classification-tag danger-tag">SUSPECT LINEUP // PROFILE ARCHIVE</span>
            <h2 class="index-title">Persons of Interest</h2>
        </div>
        <a asp-action="Create" class="btn-primary btn-danger">Register Suspect</a>
    </header>

    <div class="suspect-grid">
        @foreach (Suspect suspect in Model)
        {
            <article class="suspect-card">
                <figure class="suspect-card-media">
                    <img src="@suspect.PhotoUrl"
                         class="suspect-card-image"
                         alt="Mugshot of @suspect.Name" />
                    <figcaption class="risk-badge">
                        Risk: @Html.DisplayFor(m => suspect.RiskLevel)
                    </figcaption>
                </figure>

                <div class="card-content">
                    <h3 class="card-title">@suspect.Name</h3>
                    <p class="card-desc">AKA: @suspect.Aliases</p>

                    <dl class="suspect-meta">
                        <div class="meta-row">
                            <dt class="meta-label">Last Seen:</dt>
                            <dd class="meta-value">@suspect.LastKnownLocation</dd>
                        </div>
                        <div class="meta-row">
                            <dt class="meta-label">Role:</dt>
                            <dd class="meta-value">@suspect.RoleInCase</dd>
                        </div>
                    </dl>
                </div>

                <footer class="card-actions">
                    <a asp-action="Details" asp-route-id="@suspect.Id" class="btn-secondary">View File &rarr;</a>
                    <form asp-action="Delete" asp-route-id="@suspect.Id" method="post" class="delete-form" onsubmit="return confirm('Remove suspect from database?');">
                        <button type="submit" class="btn-danger" title="Delete Suspect Record">Delete</button>
                    </form>
                </footer>
            </article>
        }
    </div>
</section>